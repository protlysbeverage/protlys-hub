# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to GitHub — it's already in .gitignore.

# ── Supabase ───────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ── Shopify ─────────────────────────────────────────────────────────────────
# Your Shopify store URL — used for the "Shop" link and "Manage orders" button
NEXT_PUBLIC_SHOPIFY_STORE_URL=https://yourstore.myshopify.com
